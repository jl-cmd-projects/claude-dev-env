node_modules/
package-lock.json

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
*.log

# Local tooling state
.serena/
.claude/worktrees/

.planning/
_npv/

/docs/references/bdd in action.pdf
**/bdd in action.pdf

# Bugteam workflow artifacts
.bugteam-pr*-loop*.outcomes.xml
.bugteam-pr*-loop*.fix-outcomes.xml
post_pr_replies.ps1

# Eval artifacts
eval*
eval_*
eval-*
**/eval_*
**/eval-*
# Shipped opt-in capability evals under grokify (not disposable artifacts)
!packages/claude-dev-env/.agents/skills/grokify/evals/
!packages/claude-dev-env/.agents/skills/grokify/evals/**

# Draft prompt artifacts (file-based validation loop)
data/prompts/.draft-prompt.xml

# Per-user project-path registry; lives in ~/.claude/ and must never land in the repo
project-paths.json
**/project-paths.json

# Per-machine claude fallback chain; lives in ~/.claude/ and must never land in the repo
claude-chain.json
**/claude-chain.json

# Protect local identity values from accidental commits in existing worktrees.
config/local-identity.json

# Local environment variables for packages/claude-dev-env/
packages/claude-dev-env/.env
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Self-improve eval data artifacts
packages/claude-dev-env/.agents/skills/self-improve-pr-converge/self-improve-eval-data/
packages/claude-dev-env/.agents/skills/self-improve-pr-converge/scripts/self-improve-eval-data/
**/self-improve-eval-data/*.temp-*

# Local working documents — never committed per git-workflow rule
docs/plans/
.orchestrator/

# setuptools editable-install build artifacts
*.egg-info/

# Debug and test-run logs dropped in the repo root by local tooling
debug-*.log
pytestdebug.log

# Mangled Windows temp paths created as literal filenames when an unquoted
# backslash path passes through Git Bash (separators eaten, colon encoded)
*AppDataLocalTemp*


# Engine type declarations the subagent-models mod is typed against, written by /plugin-types
packages/subagent-models/.claude-plugin/types/
