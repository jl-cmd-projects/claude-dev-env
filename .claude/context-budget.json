{
  "section_detail_line_limit": 6,
  "kinds": [
    {
      "name": "archived skill",
      "patterns": [
        "skill-archive/**",
        "**/skills-archived/**"
      ],
      "line_limit": null
    },
    {
      "name": "skill entry",
      "patterns": [
        "**/SKILL.md"
      ],
      "line_limit": 200,
      "section_rule": true
    },
    {
      "name": "agent instructions",
      "patterns": [
        "**/AGENTS.md",
        "**/CLAUDE.md"
      ],
      "line_limit": 60,
      "section_rule": true
    },
    {
      "name": "rule",
      "patterns": [
        "packages/claude-dev-env/rules/*.md",
        "**/.claude/rules/*.md"
      ],
      "line_limit": 30,
      "section_rule": true
    }
  ],
  "hooks": [
    {
      "name": "task tool prompt",
      "command": [
        "python3",
        "packages/claude-dev-env/hooks/session/task_tool_prompt.py"
      ],
      "stdin": {
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "char_limit": 1500
    },
    {
      "name": "working style prompt",
      "command": [
        "python3",
        "packages/claude-dev-env/hooks/session/working_style_prompt.py"
      ],
      "stdin": {
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "char_limit": 1500
    },
    {
      "name": "advisor rules prompt",
      "command": [
        "env",
        "CLAUDE_CONFIG_DIR=packages/claude-dev-env/hooks/test_files/context_budget/advisor_config",
        "python3",
        "packages/claude-dev-env/hooks/session/advisor_rules_prompt.py"
      ],
      "stdin": {
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "char_limit": 1500
    },
    {
      "name": "orchestrator auto starter",
      "command": [
        "env",
        "CLAUDE_ORCHESTRATOR_AUTO_STARTER_ENABLED=1",
        "python3",
        "packages/claude-dev-env/hooks/session/orchestrator_auto_starter.py"
      ],
      "stdin": {
        "hook_event_name": "SessionStart",
        "source": "startup"
      },
      "char_limit": 1500
    },
    {
      "name": "skill loaded reminder",
      "command": [
        "python3",
        "packages/claude-dev-env/hooks/session/skill_loaded_reminder.py"
      ],
      "stdin": {
        "hook_event_name": "SubagentStart",
        "agent_type": "workflow-subagent"
      },
      "char_limit": 1500
    },
    {
      "name": "spawn readiness reminder",
      "command": [
        "python3",
        "packages/claude-dev-env/hooks/routing/spawn_readiness_hook.py"
      ],
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Agent",
        "tool_use_id": "toolu_budget",
        "transcript_path": "packages/claude-dev-env/hooks/test_files/context_budget/empty_transcript.jsonl",
        "tool_input": {
          "description": "Budget sample",
          "prompt": "Summarize the repository layout."
        }
      },
      "char_limit": 1500
    },
    {
      "name": "spawn oversight reminder",
      "command": [
        "python3",
        "packages/claude-dev-env/hooks/routing/spawn_oversight_hook.py"
      ],
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Agent",
        "tool_use_id": "toolu_budget",
        "transcript_path": "packages/claude-dev-env/hooks/test_files/context_budget/empty_transcript.jsonl",
        "tool_input": {
          "description": "Budget sample",
          "prompt": "Summarize the repository layout."
        }
      },
      "char_limit": 1500
    },
    {
      "name": "artifact template pointer",
      "command": [
        "python3",
        "packages/claude-dev-env/hooks/session/artifact_template_pointer.py"
      ],
      "stdin": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Artifact",
        "tool_input": {
          "action": "quickstart"
        }
      },
      "char_limit": 1500
    }
  ],
