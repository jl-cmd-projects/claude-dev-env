{
    "name": "claude-dev-env",
    "version": "8.40.1",
    "description": "Claude Code development standards — rules, hooks, agents, commands, and skills",
    "type": "module",
    "bin": {
        "claude-dev-env": "bin/install.mjs",
        "codex-compat": "bin/codex-compat.mjs",
        "cde": "bin/cde.mjs"
    },
    "scripts": {
        "test": "node --test \"bin/*.test.mjs\" \".agents/skills/**/*.test.mjs\" \"tests/fresh-session/**/*.test.mjs\" \"scripts/ci/*.test.mjs\""
    },
    "files": [
        "bin/",
        "rules/",
        "docs/",
        "commands/",
        ".agents/",
        "output-styles/",
        "hooks/",
        "system-prompts/",
        "scripts/",
        "codex-capability-map.json",
        "settings.json",
        "installable-surfaces.manifest.json",
        "_shared/",
        "audit-rubrics/",
        "codex-rules/",
        "pstack-codex-models.md",
        "AGENTS.md",
        ".claude/CLAUDE.md",
        "!**/__pycache__/**",
        "!**/*.py[cod]",
        "!**/.pytest_cache/**",
        "!**/.mypy_cache/**",
        "!**/.ruff_cache/**",
        "!**/*.log",
        "!**/debug-*.log",
        "!**/*.egg-info/**"
    ],
    "keywords": [
        "claude-code",
        "plugin",
        "cli",
        "tdd",
        "code-quality"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jl-cmd/claude-dev-env.git",
        "directory": "packages/claude-dev-env"
    }
}
